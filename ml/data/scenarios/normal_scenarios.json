                {"variation_id": "N3_b", "file_count": 5, "delay_ms": 1000},
                {"variation_id": "N3_c", "file_count": 6, "delay_ms": 800},
                {"variation_id": "N3_d", "file_count": 7, "delay_ms": 500}
