            "parameters": {
                "file_count_range": [4, 7],
                "delay_between_ops_ms_range": [500, 2000],
                "operation_types": ["file_modified", "file_created"],
                "create_probability": 0.15,
                "target_extensions": [".py", ".js", ".txt", ".cfg"]
            },
            "execution": {
                "method": "sequential_mixed_file_ops",
                "description": "Edit 4-7 files with 0.5-2s delays. Occasionally create a new file (15% chance per operation)."
            },
            "expected_features": {
                "total_events": [4, 10],
                "file_created": [0, 2],
                "file_modified": [4, 7],
                "file_deleted": [0, 0],
                "file_renamed": [0, 0],
                "unique_files_modified": [4, 7],
                "process_events": [0, 2],
                "network_events": [0, 1],
                "established_connections": [0, 0],
                "unique_remote_ips": [0, 0]
