{
    "schema_version": "1.0",
    "feature_version": "1.0",
    "window_seconds": 10,
    "scenario_class": "NORMAL",
    "label": 0,
    "description": "Normal system behavior scenarios for ML training. Each scenario represents legitimate activity that the model must learn NOT to flag as ransomware-like.",
    "safety": {
        "target_directory": "~/ransomware-lab/test-files/",
        "destructive_operations": false,
        "real_ransomware": false
    },
    "scenarios": [
        {
            "scenario_id": "N1",
            "name": "idle_system",
            "purpose": "Establish zero-activity baseline. System at rest with no user actions.",
            "label": 0,
            "parameters": {
                "duration_seconds": 15,
                "file_operations": 0,
                "process_operations": 0,
                "network_operations": 0
            },
            "execution": {
                "method": "sleep",
                "description": "Simply wait for the observation window to pass with no activity."
            },
            "expected_features": {
                "total_events": [0, 2],
                "file_created": [0, 0],
                "file_modified": [0, 0],
                "file_deleted": [0, 0],
                "file_renamed": [0, 0],
                "unique_files_modified": [0, 0],
                "process_events": [0, 2],
                "network_events": [0, 1],
                "established_connections": [0, 1],
                "unique_remote_ips": [0, 1]
            },
            "variations": [
                {"variation_id": "N1_a", "duration_seconds": 12},
                {"variation_id": "N1_b", "duration_seconds": 18},
                {"variation_id": "N1_c", "duration_seconds": 25}
            ],
            "randomization": {
                "strategy": "none",
                "seed": null
            }
        },
        {
            "scenario_id": "N2",
            "name": "light_file_editing",
            "purpose": "Simulate user editing 1-3 files with natural pauses. Common developer behavior.",
            "label": 0,
            "parameters": {
                "file_count_range": [1, 3],
                "delay_between_ops_ms_range": [1500, 4000],
                "operation_types": ["file_modified"],
                "target_extensions": [".txt", ".py", ".md"]
            },
            "execution": {
                "method": "sequential_file_modify",
                "description": "Modify 1-3 files with 1.5-4 second pauses between each modification."
            },
            "expected_features": {
                "total_events": [1, 5],
                "file_created": [0, 0],
                "file_modified": [1, 3],
                "file_deleted": [0, 0],
                "file_renamed": [0, 0],
                "unique_files_modified": [1, 3],
                "process_events": [0, 2],
                "network_events": [0, 1],
                "established_connections": [0, 0],
                "unique_remote_ips": [0, 0]
            },
            "variations": [
                {"variation_id": "N2_a", "file_count": 1, "delay_ms": 3000},
                {"variation_id": "N2_b", "file_count": 2, "delay_ms": 2000},
                {"variation_id": "N2_c", "file_count": 3, "delay_ms": 1500},
                {"variation_id": "N2_d", "file_count": 2, "delay_ms": 4000}
            ],
            "randomization": {
                "strategy": "uniform_delay",
                "seed": "per_session"
            }
        },
