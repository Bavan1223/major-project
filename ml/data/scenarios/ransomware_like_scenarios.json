                "operation_types": ["file_modified"],
                "target_extensions": [".txt", ".doc", ".pdf", ".csv"]
            },
            "execution": {
                "method": "slow_unique_file_modify",
                "description": "Modify 5-8 different files with 1-2 second gaps. Simulates stealthy/slower ransomware."
            },
            "expected_features": {
                "total_events": [5, 10],
                "file_created": [0, 0],
                "file_modified": [5, 8],
                "file_deleted": [0, 0],
                "file_renamed": [0, 0],
                "unique_files_modified": [5, 8],
                "process_events": [0, 2],
                "network_events": [0, 1],
                "established_connections": [0, 0],
                "unique_remote_ips": [0, 0]
            },
            "variations": [
                {"variation_id": "R6_a", "file_count": 5, "delay_ms": 1800},
                {"variation_id": "R6_b", "file_count": 6, "delay_ms": 1500},
                {"variation_id": "R6_c", "file_count": 7, "delay_ms": 1200},
                {"variation_id": "R6_d", "file_count": 8, "delay_ms": 1000}
