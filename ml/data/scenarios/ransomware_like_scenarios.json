                "file_modified": [10, 18],
                "file_deleted": [0, 1],
                "file_renamed": [0, 2],
                "unique_files_modified": [10, 18],
                "process_events": [0, 2],
                "network_events": [3, 6],
                "established_connections": [3, 6],
                "unique_remote_ips": [2, 4]
            },
            "variations": [
                {"variation_id": "R8_a", "files": 10, "connections": 3, "ips": 2, "delay_ms": 150},
