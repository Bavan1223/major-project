                "process_events": [3, 6],
                "network_events": [0, 2],
                "established_connections": [0, 1],
                "unique_remote_ips": [0, 1]
            },
            "variations": [
                {"variation_id": "R7_a", "processes": 3, "files_per": 3, "delay_ms": 120},
                {"variation_id": "R7_b", "processes": 4, "files_per": 4, "delay_ms": 100},
                {"variation_id": "R7_c", "processes": 5, "files_per": 5, "delay_ms": 60},
                {"variation_id": "R7_d", "processes": 6, "files_per": 3, "delay_ms": 80}
